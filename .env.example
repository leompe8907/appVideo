# Copiar a .env.local (Vite NO lee este archivo).
# .env.local está en .gitignore — nunca commitear secretos reales aquí.

# Cifrado de credenciales y sessionId en localStorage (obligatorio en producción).
VITE_SECRET_KEY=

# Tokens de API por marca (sin espacios después del =)
VITE_BRAND_TOKEN_BROMTECK=
VITE_BRAND_TOKEN_INTV=
VITE_BRAND_TOKEN_GIGMAX=
VITE_BRAND_TOKEN_CABLEATLANTICO=
VITE_BRAND_TOKEN_WIND=
VITE_BRAND_TOKEN_MULTIPLUSTV=

# Fallback para build de marca única: VITE_BRAND=wind → también acepta VITE_BRAND_TOKEN
# VITE_BRAND_TOKEN=

# Opcional: forzar bootstrap TV en dev (tizen | webos | lg | samsung)
# VITE_TV_PLATFORM=

# Build para despliegue en Smart TV: activa engines nativos Samsung/LG (Etapa 2)
# VITE_TV_DEPLOY=true
