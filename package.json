{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "chrome >= 53"
  ],
  "scripts": {
    "dev": "vite",
    "dev:brand": "vite",
    "build": "vite build",
    "build:all": "node scripts/buildAll.js",
    "build:telecable": "cross-env VITE_BRAND=telecable VITE_DEFAULT_BRAND=telecable vite build",
    "build:bromteck": "cross-env VITE_BRAND=bromteck VITE_DEFAULT_BRAND=bromteck vite build",
    "build:intv": "cross-env VITE_BRAND=intv VITE_DEFAULT_BRAND=intv vite build",
    "build:gigmax": "cross-env VITE_BRAND=gigmax VITE_DEFAULT_BRAND=gigmax vite build",
    "build:wind": "cross-env VITE_BRAND=wind VITE_DEFAULT_BRAND=wind vite build",
    "build:cableatlantico": "cross-env VITE_BRAND=cableatlantico VITE_DEFAULT_BRAND=cableatlantico vite build",
    "build:delancertv": "cross-env VITE_BRAND=cableatlantico VITE_DEFAULT_BRAND=cableatlantico vite build",
    "preview": "vite preview",
    "preview:telecable": "cross-env VITE_BRAND=telecable VITE_DEFAULT_BRAND=telecable vite preview --outDir dist/telecable",
    "preview:telecable:full": "pnpm run build:telecable && pnpm run preview:telecable",
    "preview:bromteck": "cross-env VITE_BRAND=bromteck VITE_DEFAULT_BRAND=bromteck vite preview --outDir dist/bromteck",
    "preview:bromteck:full": "pnpm run build:bromteck && pnpm run preview:bromteck",
    "preview:intv": "cross-env VITE_BRAND=intv VITE_DEFAULT_BRAND=intv vite preview --outDir dist/intv",
    "preview:intv:full": "pnpm run build:intv && pnpm run preview:intv",
    "preview:gigmax": "cross-env VITE_BRAND=gigmax VITE_DEFAULT_BRAND=gigmax vite preview --outDir dist/gigmax",
    "preview:gigmax:full": "pnpm run build:gigmax && pnpm run preview:gigmax",
    "preview:wind": "cross-env VITE_BRAND=wind VITE_DEFAULT_BRAND=wind vite preview --outDir dist/wind",
    "preview:wind:full": "pnpm run build:wind && pnpm run preview:wind",
    "preview:cableatlantico": "cross-env VITE_BRAND=cableatlantico VITE_DEFAULT_BRAND=cableatlantico vite preview --outDir dist/cableatlantico",
    "preview:cableatlantico:full": "pnpm run build:cableatlantico && pnpm run preview:cableatlantico",
    "preview:delancertv": "cross-env VITE_BRAND=cableatlantico VITE_DEFAULT_BRAND=cableatlantico vite preview --outDir dist/cableatlantico",
    "preview:delancertv:full": "pnpm run build:delancertv && pnpm run preview:delancertv",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/check-brand-secrets.js",
    "check:es-compat": "node scripts/check-es-compat.js",
    "build:verify-tv": "pnpm run build && node scripts/postbuild-es-check.js",
    "update:browserslist": "update-browserslist-db",
    "prebuild": "node scripts/check-brand-secrets.js",
    "postbuild": "node scripts/postbuild-es-check.js",
    "prebuild:all": "node scripts/check-brand-secrets.js",
    "prebuild:telecable": "node scripts/check-brand-secrets.js",
    "prebuild:bromteck": "node scripts/check-brand-secrets.js",
    "prebuild:intv": "node scripts/check-brand-secrets.js",
    "prebuild:gigmax": "node scripts/check-brand-secrets.js",
    "prebuild:wind": "node scripts/check-brand-secrets.js",
    "prebuild:cableatlantico": "node scripts/check-brand-secrets.js",
    "prebuild:delancertv": "node scripts/check-brand-secrets.js",
    "postbuild:telecable": "node scripts/postbuild-es-check.js telecable",
    "postbuild:bromteck": "node scripts/postbuild-es-check.js bromteck",
    "postbuild:intv": "node scripts/postbuild-es-check.js intv",
    "postbuild:gigmax": "node scripts/postbuild-es-check.js gigmax",
    "postbuild:wind": "node scripts/postbuild-es-check.js wind",
    "postbuild:cableatlantico": "node scripts/postbuild-es-check.js cableatlantico",
    "postbuild:delancertv": "node scripts/postbuild-es-check.js cableatlantico"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@tanstack/react-query": "^5.95.2",
    "bootstrap": "^5.3.8",
    "crypto-js": "^4.2.0",
    "embla-carousel-react": "^8.6.0",
    "hls.js": "1.6.15",
    "i18next": "^24.2.3",
    "node-forge": "^1.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^7.11.0",
    "sass": "^1.97.0",
    "video.js": "7.21.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.29.7",
    "@babel/plugin-transform-optional-chaining": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "^8.0.1",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "regenerator-runtime": "^0.14.1",
    "terser": "^5.46.1",
    "update-browserslist-db": "^1.2.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
